#!/bin/bash
set -euo pipefail

# genimage invokes this only for the newly constructed root filesystem.
[[ $# = 2 && $1 = -pvfD && $2 = /*/root.ext4 ]]
/usr/sbin/e2fsck "$@"
script_root=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
/usr/bin/python3 -B "$script_root/../scripts/normalize-ext4.py" "$2"
/usr/sbin/e2fsck -fn "$2"

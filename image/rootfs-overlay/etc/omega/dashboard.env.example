# Template only. Provision /etc/omega/dashboard.env as root:root mode 0600.
# These are literal systemd EnvironmentFile assignments, not shell commands.
# Supply absolute paths; ${NAME} expansion in the unit passes each value as
# one argument. Do not put passwords, shell substitutions, or extra flags here.
OMEGA_AI_MODEL=qwen3:1.7b
OMEGA_AI_THREADS=2
OMEGA_SURICATA_EVE=/var/log/suricata/eve.json
# Host side of the image's Pi-hole container volume:
OMEGA_PIHOLE_DATABASE=/var/lib/omega/pihole/etc-pihole/pihole-FTL.db
# This image has a Wazuh agent, not a Wazuh manager. Provision an authenticated
# manager log mirror and its heartbeat before declaring collection ready.
OMEGA_WAZUH_ALERTS=/var/lib/omega-wazuh-import/alerts/alerts.json
OMEGA_WAZUH_ARCHIVES=/var/lib/omega-wazuh-import/archives/archives.json
OMEGA_WAZUH_SYNC_STATUS=/var/lib/omega-wazuh-import/sync-status.json
# For a separately installed LOCAL manager, use /var/ossec/logs/alerts/alerts.json
# and /var/ossec/logs/archives/archives.json above, and set the heartbeat to an
# empty value: OMEGA_WAZUH_SYNC_STATUS=
# Review storage capacity and retention during provisioning. The earliest
# age/count limit applies; the dashboard also pauses below 2 GiB of free space.
OMEGA_RETENTION_DAYS=3650
OMEGA_MAX_EVENTS=50000000

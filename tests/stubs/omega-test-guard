readonly OMEGA_REAL_JQ OMEGA_REAL_CP OMEGA_REAL_MKDIR OMEGA_REAL_MKTEMP OMEGA_REAL_MV OMEGA_REAL_RM OMEGA_REAL_STAT OMEGA_REAL_LN OMEGA_REAL_CHMOD

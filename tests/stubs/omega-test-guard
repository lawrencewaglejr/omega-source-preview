readonly OMEGA_STUB_EVE_TARGET OMEGA_STUB_STATE_DIR OMEGA_STUB_ROTATE_FILE OMEGA_STUB_CONFIG_REPLACEMENT OMEGA_STUB_JQ_MODE
readonly OMEGA_STUB_SIGNAL OMEGA_STUB_AGGREGATION_MODE OMEGA_STUB_APPEND_FILE OMEGA_STUB_APPEND_TEXT OMEGA_STUB_DOCKER_MODE
readonly OMEGA_STUB_HOSTNAME_MODE OMEGA_STUB_IP_MODE OMEGA_STUB_UPTIME_MODE OMEGA_STUB_DF_MODE OMEGA_STUB_FREE_MODE
readonly OMEGA_STUB_MKDIR_MODE OMEGA_STUB_MKTEMP_MODE OMEGA_STUB_MV_MODE OMEGA_STUB_RM_MODE OMEGA_STUB_SED_MODE
readonly OMEGA_STUB_SWAP_TARGET

  "${OMEGA_REPO_ROOT:?}" "${OMEGA_EXEC_LOG:?}" "${OMEGA_STUB_LOG:?}"
: "${OMEGA_STUB_RM_SOURCE:=$OMEGA_STUB_SOURCE}"
_OMEGA_STARTUP_SIGNAL_SENT=false
_OMEGA_FINAL_SIGNAL_SENT=false
readonly BASH_ENV HOME TMPDIR OMEGA_TRUSTED_PATH OMEGA_STUB_BIN OMEGA_STUB_SOURCE OMEGA_STUB_RM_SOURCE OMEGA_REPO_ROOT OMEGA_EXEC_LOG OMEGA_STUB_LOG
